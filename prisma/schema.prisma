datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String      @id @default(uuid())
  name         String
  username     String      @unique
  email        String?     @unique
  password     String
  role         String      @default("STAFF_INPUT") // OWNER, ADMIN, STAFF_INPUT, VIEWER
  phone        String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdJobs     Job[]         @relation("JobCreatedBy")
  updatedJobs     Job[]         @relation("JobUpdatedBy")
  assignedJobs    Job[]         @relation("JobAssignedTo")
  validatedJobs   Job[]         @relation("JobValidatedBy")
  uploadedPhotos  JobPhoto[]
  auditLogs       AuditLog[]
  payrollSlips    PayrollSlip[] @relation("UserPayrolls")
  createdPayrolls PayrollSlip[] @relation("PayrollCreatedBy")
  createdExpenses Expense[]     @relation("ExpenseCreatedBy")
  notifications   Notification[] @relation("UserNotifications")

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  address     String   @db.Text
  notes       String?  @db.Text
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("customers")
}

model Service {
  id           Int      @id @default(autoincrement())
  name         String
  category     String   // CLEANING, AC, KELISTRIKAN, LAINNYA
  defaultPrice Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  jobs Job[]

  @@map("services")
}

model Job {
  id                   String    @id @default(uuid())
  jobNumber            String    @unique
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id])
  serviceId            Int
  service              Service   @relation(fields: [serviceId], references: [id])
  jobDetails           String?   @db.Text
  scheduledDate        String    // YYYY-MM-DD
  scheduledTime        String?   // HH:mm
  technicianName       String?
  basePrice            Float     @default(0)
  extraFee             Float     @default(0)
  discount             Float     @default(0)
  totalPrice           Float     @default(0)
  technicianCommission    Float     @default(0) // Estimasi komisi teknisi (default 15%)
  commissionStatus        String    @default("UNPAID") // UNPAID, PAID
  commissionPaidAt        DateTime?
  commissionPaymentMethod String?   // TRANSFER_BCA, TRANSFER_BRI, TRANSFER_MANDIRI, CASH
  commissionProofPath     String?   // Foto / Bukti Struk Transfer Bank
  commissionNotes         String?   @db.Text
  status                  String    @default("MENUNGGU_DISPOSISI") // MENUNGGU_DISPOSISI, DIDISPOSISIKAN, MENUJU_LOKASI, TIBA_DI_LOKASI, DALAM_PENGERJAAN, MENUNGGU_VALIDASI, SELESAI, DIBATALKAN
  isPool               Boolean   @default(false) // Jika true, teknisi bisa ambil sendiri ala Gojek
  assignedToId         String?
  assignedTo           User?     @relation("JobAssignedTo", fields: [assignedToId], references: [id])
  checkinAt            DateTime?
  checkinNotes         String?   @db.Text
  validatedAt          DateTime?
  validatedById        String?
  validatedBy          User?     @relation("JobValidatedBy", fields: [validatedById], references: [id])
  notes                String?   @db.Text
  createdById          String
  createdBy            User      @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedById          String?
  updatedBy            User?     @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  completedAt          DateTime?
  isDeleted            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  photos    JobPhoto[]
  auditLogs AuditLog[]

  @@map("jobs")
}

model JobPhoto {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  photoType    String   // CHECKIN, BEFORE, AFTER
  filePath     String
  fileName     String
  fileSize     Int?
  caption      String?  @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("job_photos")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, STATUS_CHANGE, DELETE, LOGIN, DISPOSITION, VALIDATION
  entity    String   // JOB, CUSTOMER, USER, SERVICE, PAYROLL, EXPENSE
  entityId  String?
  details   String?  @db.Text // JSON string or notes
  ipAddress String?
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model PayrollSlip {
  id             String    @id @default(uuid())
  slipNumber     String    @unique
  userId         String?
  user           User?     @relation("UserPayrolls", fields: [userId], references: [id])
  employeeName   String
  employeeRole   String
  month          Int
  year           Int
  periodStart    String
  periodEnd      String
  basicSalary    Float     @default(0)
  jobCommission  Float     @default(0)
  allowance      Float     @default(0)
  bonus          Float     @default(0)
  deductions     Float     @default(0)
  netSalary      Float     @default(0)
  paymentStatus  String    @default("DRAFT")
  paymentDate    DateTime?
  paymentMethod  String?
  notes          String?   @db.Text
  createdById    String
  createdBy      User      @relation("PayrollCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("payroll_slips")
}

model Expense {
  id          String   @id @default(uuid())
  title       String
  category    String   // OPERASIONAL, PERALATAN, TRANSPORT, KONSUMSI, LAINNYA
  amount      Float
  expenseDate String   // YYYY-MM-DD
  receiptUrl  String?
  notes       String?  @db.Text
  createdById String
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("expenses")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("INFO") // DISPATCH, APPROVAL, VALIDATION, POOL, SYSTEM
  linkUrl   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
